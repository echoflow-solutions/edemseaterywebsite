# Environment variables for Edem's Eatery Website
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Square — online pickup ordering
# ---------------------------------------------------------------------------
# Until SQUARE_ACCESS_TOKEN and SQUARE_LOCATION_ID are both set, the cart
# hides card payment and falls back to the ordering page and phone number.
#
# Get these from https://developer.squareup.com/apps
#   1. Open your application
#   2. Switch the Sandbox / Production toggle to the environment you want
#   3. Credentials  -> Access token
#      Locations    -> Location ID
#
# Start with Sandbox. Nothing is charged and you can pay with Square's test
# card 4111 1111 1111 1111, any future expiry, any CVV, postcode 2170.

# "sandbox" (default) or "production"
SQUARE_ENVIRONMENT=sandbox

# Sandbox tokens begin with EAAA... — treat as a password, server-side only
SQUARE_ACCESS_TOKEN=

# The location the orders belong to, e.g. L1A2B3C4D5E6F
SQUARE_LOCATION_ID=

# ---------------------------------------------------------------------------
# Square webhooks (optional — order and payment events are logged if set)
# ---------------------------------------------------------------------------
# Developer Console -> your app -> Webhooks -> Subscriptions.
# The notification URL must match the subscription exactly, or every incoming
# webhook will fail signature verification.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://edemseatery.com.au/api/webhooks/square
